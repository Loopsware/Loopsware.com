---
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Loopsware is a product studio in Guanajuato. We build consumer apps for travel and food — Plany and Recipy.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#030503" />
		<meta property="og:image" content="https://loopsware.com/images/loopsware_sq_logo.png" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://loopsware.com" />
		<meta property="og:type" content="website" />
		<meta property="twitter:image" content="https://loopsware.com/images/loopsware_sq_logo.png" />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
:root {
	--void: #030503;
	--panel: #070b07;
	--green: #107c10;
	--lime: #9bf00b;
	--phosphor: #7eb900;
	--text: #eef2ee;
	--muted: #8a938a;
	--line: rgba(155, 240, 11, 0.14);
	--font-display: "Telegraf", system-ui, sans-serif;
	--font-body: "PierSans", "Inter", system-ui, sans-serif;
	--font-ui: "Inter", system-ui, sans-serif;
}

html {
	font-family: var(--font-body);
	background: var(--void);
	color: var(--text);
	color-scheme: dark;
	box-sizing: border-box;
	overflow-x: hidden;
	scroll-behavior: smooth;
}

*,
*::before,
*::after {
	box-sizing: inherit;
}

body {
	margin: 0;
	min-height: 100vh;
	background: var(--void);
	position: relative;
}

::selection {
	background: var(--lime);
	color: #031003;
}

.hero-canvas {
	position: fixed;
	inset: 0;
	z-index: 0;
	pointer-events: none;
}

.hero-canvas canvas {
	display: block;
	width: 100%;
	height: 100%;
}

.grain {
	position: fixed;
	inset: 0;
	z-index: 1;
	pointer-events: none;
	opacity: 0.045;
	mix-blend-mode: overlay;
	background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

.vignette {
	position: fixed;
	inset: 0;
	z-index: 1;
	pointer-events: none;
	background:
		radial-gradient(ellipse at center, transparent 42%, rgba(3, 5, 3, 0.72) 100%),
		linear-gradient(to top, rgba(3, 5, 3, 0.55) 0%, transparent 28%);
}

@font-face {
	font-family: "Grotesque";
	src: url("/fonts/Grotesque-Black.otf");
	font-display: swap;
}

@font-face {
	font-family: "Inter";
	src: url("/fonts/Inter-Regular.otf");
	font-weight: 400;
	font-style: normal;
	font-display: swap;
}

@font-face {
	font-family: "Inter";
	src: url("/fonts/Inter-SemiBold.otf");
	font-weight: 600;
	font-style: normal;
	font-display: swap;
}

@font-face {
	font-family: "Inter";
	src: url("/fonts/Inter-Bold.otf");
	font-weight: 700;
	font-style: normal;
	font-display: swap;
}

@font-face {
	font-family: "Telegraf";
	src: url("/fonts/PPTelegraf-UltraBold.otf");
	font-weight: 700;
	font-style: normal;
	font-display: swap;
}

@font-face {
	font-family: "Telegraf";
	src: url("/fonts/PPTelegraf-Regular.otf");
	font-weight: 400;
	font-style: normal;
	font-display: swap;
}

@font-face {
	font-family: "PierSans";
	src: url("/fonts/PPPierSans-Regular.otf");
	font-weight: 400;
	font-style: normal;
	font-display: swap;
}

@font-face {
	font-family: "PierSans";
	src: url("/fonts/PPPierSans-Bold.otf");
	font-weight: 700;
	font-style: normal;
	font-display: swap;
}

@font-face {
	font-family: "EditorialNew";
	src: url("/fonts/PPEditorialNew-UltraboldItalic.otf");
	font-weight: 800;
	font-style: italic;
	font-display: swap;
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}

	.opacity-0.animate-fade-in-up,
	.opacity-0.animate-fade-in-left,
	.opacity-0.animate-fade-in-right {
		animation: none !important;
		opacity: 1 !important;
		transform: none !important;
	}
}
</style>
