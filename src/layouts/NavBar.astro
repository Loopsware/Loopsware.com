---
import { translations } from '../translations';
let lang: string = Astro.props.lang || 'en';
const t = translations[lang].navbar;
---

<nav class="navbar flex items-center justify-between w-full px-6 md:px-12 lg:px-16 pt-8 md:pt-10 pb-4 z-40 relative">
  <a class="opacity-0 animate-fade-in-up [animation-delay:200ms]" href="/">
    <img class="h-6 md:h-7 w-auto" src="/images/loopsware_logo.png" alt="loopsware" />
  </a>

  <div class="hidden md:flex items-center gap-8 opacity-0 animate-fade-in-up [animation-delay:300ms]">
    <a style={{ "font-family": "Telegraf" }} class="text-gray-300 hover:text-lime-300 text-sm transition-colors" href="/#services">{t.services}</a>
    <a style={{ "font-family": "Telegraf" }} class="text-gray-300 hover:text-lime-300 text-sm transition-colors" href="/#pricing">{t.pricing}</a>
    <a style={{ "font-family": "Telegraf" }} class="text-gray-300 hover:text-lime-300 text-sm transition-colors" href="/#about">{t.about}</a>
  </div>

  <a
    href="mailto:sales@loopsware.com?subject=Discovery%20call"
    class="hidden md:inline-flex items-center bg-lime-300 hover:bg-lime-400 text-black rounded-full px-5 py-2.5 transition-all opacity-0 animate-fade-in-up [animation-delay:400ms]"
  >
    <span style={{ "font-family": "Telegraf" }} class="font-bold text-sm">{t.contact}</span>
  </a>

  <button id="menu-button" class="md:hidden text-white opacity-0 animate-fade-in-up [animation-delay:300ms]" aria-label="Toggle menu">
    <span id="line1" class="block w-7 h-[2px] bg-white mb-2 transition-transform duration-200 rounded"></span>
    <span id="line2" class="block w-7 h-[2px] bg-white transition-transform duration-200 rounded"></span>
  </button>
</nav>

<div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-50 bg-black/95 backdrop-blur-md flex-col items-center justify-center gap-8 px-8">
  <a style={{ "font-family": "Telegraf" }} class="text-white text-2xl" href="/#services">{t.services}</a>
  <a style={{ "font-family": "Telegraf" }} class="text-white text-2xl" href="/#pricing">{t.pricing}</a>
  <a style={{ "font-family": "Telegraf" }} class="text-white text-2xl" href="/#about">{t.about}</a>
  <a
    href="mailto:sales@loopsware.com?subject=Discovery%20call"
    class="mt-4 inline-flex items-center bg-lime-300 text-black rounded-full px-7 py-3"
  >
    <span style={{ "font-family": "Telegraf" }} class="font-bold text-base">{t.contact}</span>
  </a>
  <button id="menu-close" class="absolute top-8 right-8 text-white text-3xl" aria-label="Close menu">×</button>
</div>

<script is:inline>
  (function () {
    const button = document.getElementById('menu-button');
    const close = document.getElementById('menu-close');
    const menu = document.getElementById('mobile-menu');
    const links = menu ? menu.querySelectorAll('a') : [];

    function open() {
      if (!menu) return;
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function shut() {
      if (!menu) return;
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      document.body.style.overflow = '';
    }

    button && button.addEventListener('click', open);
    close && close.addEventListener('click', shut);
    links.forEach((l) => l.addEventListener('click', shut));
  })();
</script>
