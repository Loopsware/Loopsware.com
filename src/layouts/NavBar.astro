---
import { translations } from '../translations';

interface Props {
  lang?: string;
}

const lang: string = Astro.props.lang || 'en';
const t = translations[lang].navbar;
---

<header class="fixed top-0 inset-x-0 z-40 mix-blend-normal">
  <nav class="flex items-center justify-between px-5 md:px-8 lg:px-12 pt-6 md:pt-8 pb-4">
    <a
      href="/"
      class="flex items-center gap-2.5 opacity-0 animate-fade-in-up [animation-delay:120ms] group"
    >
      <img src="/images/favicon.svg" alt="" class="h-6 w-6" />
      <span
        style={{ "font-family": "Telegraf" }}
        class="text-[13px] md:text-sm tracking-[0.22em] text-[var(--text)] group-hover:text-[var(--lime)] transition-colors"
      >
        LOOPSWARE
      </span>
    </a>

    <div class="hidden md:flex items-center gap-3 opacity-0 animate-fade-in-up [animation-delay:220ms]">
      <a
        style={{ "font-family": "Telegraf" }}
        class="text-[11px] tracking-[0.22em] text-[var(--text)] hover:text-[var(--lime)] transition-colors"
        href="/#products"
      >
        {t.products}
      </a>
      <span class="text-[var(--lime)]/50 text-[10px]" aria-hidden="true">•</span>
      <a
        style={{ "font-family": "Telegraf" }}
        class="text-[11px] tracking-[0.22em] text-[var(--text)] hover:text-[var(--lime)] transition-colors"
        href="/about"
      >
        {t.about}
      </a>
    </div>

    <button
      id="menu-button"
      class="md:hidden text-[var(--text)] opacity-0 animate-fade-in-up [animation-delay:220ms]"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span id="line1" class="block w-6 h-px bg-[var(--lime)] mb-2"></span>
      <span id="line2" class="block w-6 h-px bg-[var(--lime)]"></span>
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class="hidden md:hidden fixed inset-0 z-50 bg-[var(--void)]/96 backdrop-blur-md flex-col items-center justify-center gap-10 px-8"
>
  <a style={{ "font-family": "Telegraf" }} class="text-[var(--text)] text-2xl tracking-[0.18em]" href="/#products">{t.products}</a>
  <a style={{ "font-family": "Telegraf" }} class="text-[var(--text)] text-2xl tracking-[0.18em]" href="/about">{t.about}</a>
  <button id="menu-close" class="absolute top-7 right-6 text-[var(--lime)] text-3xl leading-none" aria-label="Close menu">×</button>
</div>

<script is:inline>
  (function () {
    const button = document.getElementById('menu-button');
    const close = document.getElementById('menu-close');
    const menu = document.getElementById('mobile-menu');
    const links = menu ? menu.querySelectorAll('a') : [];

    function open() {
      if (!menu) return;
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      document.body.style.overflow = 'hidden';
      button && button.setAttribute('aria-expanded', 'true');
    }
    function shut() {
      if (!menu) return;
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      document.body.style.overflow = '';
      button && button.setAttribute('aria-expanded', 'false');
    }

    button && button.addEventListener('click', open);
    close && close.addEventListener('click', shut);
    links.forEach((l) => l.addEventListener('click', shut));
  })();
</script>
