---
import Layout from '../layouts/Layout.astro';
import NavBar from '../layouts/NavBar.astro';
import Footer from '../layouts/Footer.astro';
---

<Layout title="Loopsware | Terms & Conditions">
    <NavBar />
    <main class="relative z-10 px-5 md:px-8 lg:px-12 pt-28 md:pt-36 pb-24 min-h-[60vh]">
        <p
            style={{ "font-family": "Telegraf" }}
            class="text-[var(--lime)] text-[11px] tracking-[0.32em] mb-6"
        >
            LEGAL
        </p>
        <h1
            style={{ "font-family": "Telegraf" }}
            class="text-[var(--text)] text-4xl md:text-6xl font-bold tracking-tight"
        >
            Terms &amp; Conditions
        </h1>
        <p
            style={{ "font-family": "PierSans" }}
            class="text-[var(--muted)] mt-8 max-w-xl leading-relaxed"
        >
            Product-specific terms live on each app. For studio inquiries, write to
            <a class="text-[var(--lime)] hover:text-[var(--text)]" href="mailto:oliver@loopsware.com">oliver@loopsware.com</a>.
        </p>
    </main>
    <Footer />
</Layout>
