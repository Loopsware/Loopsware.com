---
import SpeedInsights from "@vercel/speed-insights/astro";
import Layout from "../layouts/Layout.astro";
import NavBar from "../layouts/NavBar.astro";
import Footer from "../layouts/Footer.astro";
import HeroCanvas from "../components/react/HeroCanvas";
import ProductShowcase from "../components/ProductShowcase.astro";
import { products } from "../data/products";
---

<Layout title="Loopsware — Product studio">
	<SpeedInsights />
	<HeroCanvas client:load />
	<div class="grain" aria-hidden="true"></div>
	<div class="vignette" aria-hidden="true"></div>
	<NavBar />

	<main class="relative z-10">
		<section id="hero" class="min-h-[100svh] flex flex-col justify-end px-5 md:px-8 lg:px-12 pb-10 md:pb-14">
			<div class="max-w-4xl opacity-0 animate-fade-in-up [animation-delay:400ms]">
				<p
					style={{ "font-family": "Telegraf" }}
					class="text-[var(--lime)] text-[11px] tracking-[0.32em] mb-6"
				>
					PRODUCT STUDIO
				</p>
				<h1
					style={{ "font-family": "Telegraf" }}
					class="text-[var(--text)] text-5xl md:text-7xl lg:text-8xl font-bold leading-[0.92] tracking-tight"
				>
					Two products.<br />One studio.
				</h1>
				<p
					style={{ "font-family": "PierSans" }}
					class="text-[var(--muted)] text-base md:text-lg mt-8 max-w-md leading-relaxed"
				>
					Consumer apps for how people move and eat — built in Guanajuato, shipped worldwide.
				</p>
			</div>

			<div class="flex items-end justify-between mt-16 md:mt-20 opacity-0 animate-fade-in-up [animation-delay:700ms]">
				<p
					style={{ "font-family": "Telegraf" }}
					class="text-[11px] tracking-[0.28em] text-[var(--text)]"
				>
					GUANAJUATO, MX
				</p>
				<a
					href="#products"
					style={{ "font-family": "Telegraf" }}
					class="text-[11px] tracking-[0.28em] text-[var(--lime)] hover:text-[var(--text)] transition-colors"
				>
					SCROLL
				</a>
			</div>
		</section>

		<section id="products" class="relative bg-[var(--void)] px-5 md:px-8 lg:px-12 pt-8 pb-8">
			<p
				style={{ "font-family": "Telegraf" }}
				class="text-[var(--lime)] text-[11px] tracking-[0.32em] pt-10 md:pt-14"
			>
				PRODUCTS
			</p>
			{products.map((product, i) => (
				<ProductShowcase product={product} reversed={i % 2 === 1} />
			))}
		</section>
	</main>

	<Footer />
</Layout>
