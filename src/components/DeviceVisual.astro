---
interface Props {
  slug: "plany" | "recipy";
}

const { slug } = Astro.props;
---

<div class="device" data-product={slug}>
  <div class="device-bezel">
    <div class="device-notch"></div>
    {slug === "plany" ? (
      <svg class="device-screen" viewBox="0 0 260 520" fill="none" aria-hidden="true">
        <rect width="260" height="520" fill="#071107" />
        <text x="20" y="48" fill="#8a938a" font-size="9" letter-spacing="2.4" font-family="ui-sans-serif, system-ui">ROUTE</text>
        <text x="20" y="78" fill="#eef2ee" font-size="22" font-weight="700" font-family="ui-sans-serif, system-ui">Lisbon, 4 days</text>
        <circle cx="130" cy="250" r="118" stroke="#107c10" stroke-opacity="0.25" />
        <circle cx="130" cy="250" r="78" stroke="#107c10" stroke-opacity="0.18" />
        <path d="M58 292 C 88 240, 110 214, 148 198 C 176 186, 196 210, 214 236 C 226 256, 208 286, 176 304 C 142 322, 96 330, 58 292 Z" stroke="#9bf00b" stroke-width="1.6" fill="none" />
        <circle cx="88" cy="246" r="4" fill="#9bf00b" />
        <circle cx="148" cy="198" r="4" fill="#9bf00b" />
        <circle cx="214" cy="236" r="4" fill="#9bf00b" />
        <circle cx="176" cy="304" r="4" fill="#9bf00b" />
        <circle cx="58" cy="292" r="5.5" fill="#9bf00b" />
        <rect x="18" y="400" width="224" height="52" rx="10" fill="#0d160d" stroke="#9bf00b" stroke-opacity="0.22" />
        <text x="34" y="422" fill="#9bf00b" font-size="9" letter-spacing="1.6" font-family="ui-sans-serif, system-ui">DAY 02</text>
        <text x="34" y="440" fill="#eef2ee" font-size="12" font-family="ui-sans-serif, system-ui">Alfama · 6 spots · 8.4 km</text>
      </svg>
    ) : (
      <svg class="device-screen" viewBox="0 0 260 520" fill="none" aria-hidden="true">
        <rect width="260" height="520" fill="#071107" />
        <text x="20" y="48" fill="#8a938a" font-size="9" letter-spacing="2.4" font-family="ui-sans-serif, system-ui">THIS WEEK</text>
        <text x="20" y="78" fill="#eef2ee" font-size="22" font-weight="700" font-family="ui-sans-serif, system-ui">Wed · $54.20</text>
        <rect x="18" y="108" width="224" height="88" rx="12" fill="#0d160d" stroke="#107c10" stroke-opacity="0.35" />
        <text x="34" y="134" fill="#9bf00b" font-size="9" letter-spacing="1.4" font-family="ui-sans-serif, system-ui">BREAKFAST</text>
        <text x="34" y="156" fill="#eef2ee" font-size="14" font-family="ui-sans-serif, system-ui">Yogurt bowl</text>
        <text x="34" y="176" fill="#8a938a" font-size="11" font-family="ui-sans-serif, system-ui">P 28  ·  C 32  ·  F 12</text>
        <rect x="18" y="208" width="224" height="88" rx="12" fill="#0d160d" stroke="#107c10" stroke-opacity="0.35" />
        <text x="34" y="234" fill="#9bf00b" font-size="9" letter-spacing="1.4" font-family="ui-sans-serif, system-ui">LUNCH</text>
        <text x="34" y="256" fill="#eef2ee" font-size="14" font-family="ui-sans-serif, system-ui">Chicken rice</text>
        <text x="34" y="276" fill="#8a938a" font-size="11" font-family="ui-sans-serif, system-ui">P 42  ·  C 48  ·  F 14</text>
        <rect x="18" y="308" width="224" height="88" rx="12" fill="#0d160d" stroke="#9bf00b" stroke-opacity="0.45" />
        <text x="34" y="334" fill="#9bf00b" font-size="9" letter-spacing="1.4" font-family="ui-sans-serif, system-ui">DINNER</text>
        <text x="34" y="356" fill="#eef2ee" font-size="14" font-family="ui-sans-serif, system-ui">Salmon + greens</text>
        <text x="34" y="376" fill="#8a938a" font-size="11" font-family="ui-sans-serif, system-ui">P 38  ·  C 18  ·  F 22</text>
        <circle cx="206" cy="454" r="28" stroke="#9bf00b" stroke-width="3" stroke-dasharray="120 176" />
        <text x="193" y="458" fill="#eef2ee" font-size="11" font-family="ui-sans-serif, system-ui">14</text>
      </svg>
    )}
  </div>
</div>

<style>
  .device {
    display: flex;
    justify-content: center;
  }

  .device-bezel {
    position: relative;
    width: min(100%, 280px);
    border-radius: 36px;
    padding: 10px;
    background: linear-gradient(160deg, #1a241a, #050805 40%, #0a120a);
    box-shadow:
      0 0 0 1px rgba(155, 240, 11, 0.16),
      0 24px 80px rgba(0, 0, 0, 0.55),
      0 0 60px rgba(16, 124, 16, 0.12);
  }

  .device-notch {
    position: absolute;
    top: 18px;
    left: 50%;
    width: 72px;
    height: 10px;
    border-radius: 999px;
    background: #030503;
    transform: translateX(-50%);
    z-index: 1;
  }

  .device-screen {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px;
  }
</style>
